# Server
PORT=5000
NODE_ENV=development

# MySQL connection. These defaults match docker-compose.yml.
# Using XAMPP instead? Its root account has NO password by default, so leave
# DB_PASSWORD empty (just `DB_PASSWORD=`). Check the port in the XAMPP control
# panel too - it is usually 3306 but gets moved to 3307 when something else
# already holds the default.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=coffee_pos

# JWT secrets - use long random strings in production, keep ACCESS and REFRESH different
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
